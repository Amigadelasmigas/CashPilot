#!/bin/sh
# Prints the exit IP and country this network namespace reaches the internet
# from, as one line of JSON: {"ip":"203.0.113.7","country":"ES"}.
# Exit status 1 when no IP-echo endpoint answers.
#
# CP_DEADLINE (set by cp-tunnel): the epoch second by which the worker reads
# the answer. Until then each request gets its cap or the time left, whichever
# is less, and at least 1 s; the country, which only labels the answer, is
# skipped with under 2 s left. The worker waits 5 s past the deadline, so those
# 5 s count too: 1 s per request, no country. Only after them does nobody
# wait, and every request gets its full time again.
set -u

cap() {
    left=$((${CP_DEADLINE:-0} - $(date +%s)))
    if [ -z "${CP_DEADLINE:-}" ] || [ "$left" -lt -5 ] || [ "$left" -ge "$1" ]; then
        echo "$1"
    elif [ "$left" -lt 1 ]; then echo 1; else echo "$left"; fi
}

# Four decimal octets of 0 to 255. A leading zero ("007") is refused, as the
# worker's parser (Python's ipaddress) refuses it; a single "0" is an octet.
is_ipv4() {
    case "$1" in *[!0-9.]* | *..* | .* | *.) return 1 ;; esac
    old_ifs=$IFS
    IFS=.
    # shellcheck disable=SC2086 # split on the dots
    set -- $1
    IFS=$old_ifs
    [ "$#" -eq 4 ] || return 1
    for octet in "$@"; do
        case "$octet" in 0?*) return 1 ;; esac
        [ "${#octet}" -le 3 ] && [ "$octet" -le 255 ] || return 1
    done
}

# An address, or nothing: an error page ("e", or a line more) is no exit,
# and the next endpoint gets its turn.
is_ip() {
    case "$1" in
    *:*:*)
        addr=$1
        # The last 32 bits may be written as IPv4 (::ffff:203.0.113.7, RFC 4291
        # 2.2): checked as IPv4, then counted as the two groups it stands for.
        case "$addr" in *.*)
            is_ipv4 "${addr##*:}" || return 1
            addr="${addr%:*}:0:0"
            ;;
        esac
        # Hex groups of up to 4 between colons: 8 groups (7 colons), or at most
        # 7 around one "::", which stands for one or more zero groups (RFC 4291
        # 2.2), so "1:2:3:4:5:6:7::" is one. ":::" and a lone edge colon are not.
        case "$addr" in *[!0-9a-fA-F:]* | *:::* | *::*::* | :[!:]* | *[!:]:) return 1 ;; esac
        compressed=no
        case "$addr" in *::*) compressed=yes ;; esac
        colons=$(printf '%s' "$addr" | tr -cd ':' | wc -c)
        if [ "$compressed" = no ] && [ "$colons" -ne 7 ]; then return 1; fi
        old_ifs=$IFS
        IFS=:
        # shellcheck disable=SC2086 # split on the colons
        set -- $addr
        IFS=$old_ifs
        groups=0
        for group in "$@"; do
            [ "${#group}" -le 4 ] || return 1
            if [ -n "$group" ]; then groups=$((groups + 1)); fi
        done
        if [ "$compressed" = yes ] && [ "$groups" -gt 7 ]; then return 1; fi
        ;;
    *.*.*.*) is_ipv4 "$1" ;;
    *) return 1 ;;
    esac
}

# Blanks and line breaks are trimmed from both ends of an answer only. One
# inside it stays, so is_ip refuses the answer: deleting it would join
# "203.0.113.7" and a stray " 8" into another address.
blanks=" $(printf '\t\r')
"
trim() {
    s=$1
    while :; do case "$s" in [$blanks]*) s=${s#?} ;; *) break ;; esac; done
    while :; do case "$s" in *[$blanks]) s=${s%?} ;; *) break ;; esac; done
    printf '%s' "$s"
}

ip=""
for url in https://api.ipify.org https://ifconfig.me/ip https://icanhazip.com; do
    # An answer over 64 bytes is no address, even if its first 64 hold one.
    # The "x" keeps trailing line breaks in the count: $(...) drops them.
    raw=$(
        curl -fsS --max-time "$(cap 8)" "$url" 2>/dev/null | head -c 65
        echo x
    )
    raw=${raw%x}
    ip=""
    [ "${#raw}" -le 64 ] && ip=$(trim "$raw")
    is_ip "$ip" && break
    ip=""
done
[ -n "$ip" ] || exit 1

country=""
t=$(cap 8)
if [ "$t" -ge 2 ]; then
    country=$(curl -fsS --max-time "$t" "https://ipinfo.io/$ip/country" 2>/dev/null | tr -cd 'A-Z' | cut -c1-2)
fi
printf '{"ip":"%s","country":"%s"}\n' "$ip" "$country"
